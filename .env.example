# ============================================================
# TEV TESORERÍA - ARCHIVO DE PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo a .env y asigna valores reales en local/staging
# ============================================================

ENVIRONMENT=development
DATABASE_URL=sqlite:///tev_tesoreria.db
JWT_SECRET_KEY=cambiar-por-secreto-jwt-produccion-32-caracteres-minimo
ACCESS_TOKEN_EXPIRE_HOURS=12
MASTER_ADMIN_KEY=cambiar-clave-maestra-gobernanza-produccion
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Almacenamiento Remoto de Backups (Cloudflare R2 / AWS S3)
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=tev-tesoreria-backups
S3_ACCESS_KEY_ID=<tu_access_key_id>
S3_SECRET_ACCESS_KEY=<tu_secret_access_key>
S3_REGION=auto
